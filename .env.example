# =====================================================================
# CẤU HÌNH HỆ THỐNG LỌC NHIÊN LIỆU AI VICOMSAT (VICOMSAT FUEL SERVICE)
# =====================================================================

# 1. Cấu hình Cổng Mạng (Network & Port)
HOST=0.0.0.0
PORT=8000

# 2. Cấu hình Bảo mật (API Key Security)
# Mã khóa bí mật để xác thực khi gọi API từ xa
API_KEY=vicomsat_secret_key_2026

# Bật/Tắt chế độ bắt buộc có API Key (true/false)
# - Đặt false khi chạy thử nghiệm / Demo nội bộ
# - Đặt true khi bàn giao triển khai chính thức cho Doanh nghiệp
REQUIRE_API_KEY=false

# 3. Cấu hình Cơ sở dữ liệu chuẩn 3NF (Pluggable Database Adapter)
# - Mặc định dùng SQLite (tự sinh file, không cần cài server DB):
DATABASE_URL=sqlite:///./fuel_records.db

# - Nếu dùng PostgreSQL / TimescaleDB (Doanh nghiệp):
# DATABASE_URL=postgresql://postgres:password@localhost:5432/fuel_records

# - Nếu dùng MySQL / MariaDB:
# DATABASE_URL=mysql+pymysql://root:password@localhost:3306/fuel_records

# - Nếu KHÔNG MUỐN hệ thống tự lưu (Doanh nghiệp tự lưu):
# DATABASE_URL=NONE
